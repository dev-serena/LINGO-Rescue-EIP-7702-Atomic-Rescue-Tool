# ── Wallets ────────────────────────────────────────────────────────────────────
COMPROMISED_PRIVATE_KEY=0x...
SPONSOR_PRIVATE_KEY=0x...
SAFE_DESTINATION=0x...

# ── RPC — use WebSocket wss:// for best performance  chainstack pass Milka#333


RPC_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY      # écoute — WebSocket gratuit
RPC_BROADCAST=https://lb.drpc.live/base/YOUR_KEY
RPC_BROADCAST2=https://mainnet.base.org

# ── RescueExecutor ────────────────────────────────────────────────────────────
# Already deployed on Base mainnet — use this address directly
# Or deploy your own from RescueExecutor.sol on Remix
EXECUTOR_ADDRESS=0xBe7b686B3d9919Db04526c3935c6d72E86310AE1

# ── Gas (watcher.js) ──────────────────────────────────────────────────────────
# maxPriorityFeePerGas in Gwei — leave empty for auto (2x estimated)
# On Base, FIFO sequencer — priority fee doesn't affect ordering
# but a small tip helps. Default auto is fine.
# Sweeper observed at ~1.034 Gwei — set higher to beat it
# MAX_FEE_GWEI=2
# MAX_PRIORITY_GWEI=1.5

# ── Rescue mode ────────────────────────────────────────────────────────────────
# transfer → Tx1: sponsor sends LINGO to compromised / Tx2: rescue sweeps all
# claim    → Tx1: (none) / Tx2: claim() + transfer all
# unstake  → Tx1: (none) / Tx2: unstake() + transfer all
RESCUE_MODE=transfer

# ── Transfer mode: how much LINGO sponsor sends in Tx1 ────────────────────────
# Must be <= sponsor's LINGO balance. Script checks this.
SEND_AMOUNT=10

# ── Claim params (RESCUE_MODE=claim only) ─────────────────────────────────────
CLAIM_AMOUNT=
CLAIM_NONCE=
CLAIM_SIGNATURE=

# ── Unstake params (RESCUE_MODE=unstake only) ─────────────────────────────────
# exemple STAKE_INDICES=10,11,12
STAKE_INDICES=
